{
  "installCommand": "npm install",
  "buildCommand": "node --max-old-space-size=4096 node_modules/@angular/cli/bin/ng.js build --configuration production",
  "outputDirectory": "dist/bounceup/browser",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
