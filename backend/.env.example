# ============================================================
# BounceUp Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/bounceup"

# Server port
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:4200"

# ── SMTP / Email ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Admin email (receives booking notifications)
ADMIN_EMAIL="admin@bounceup.de"

# Sender name shown in emails
MAIL_FROM_NAME="BounceUp Hüpfburg-Verleih"
